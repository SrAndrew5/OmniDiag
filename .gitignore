*.py[cod]
*.class
.venv/
venv/
env/

# PyInstaller y compilaciones
build/
dist/
*.spec.bak

# Base de datos SQLite local con registros y lecturas personales
datos/*.db
datos/*.sqlite
datos/*.sqlite3

# Carpetas de datos locales (preservan estructura vacia con .gitkeep)
